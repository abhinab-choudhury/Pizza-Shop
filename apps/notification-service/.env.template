# LOCAL DEV ONLY. Skips service-token verification on POST /notifications/events.
# auth-service exposes no route that mints client-credentials tokens yet, so this
# is the only way to exercise the publish path today. Never set in production.
ALLOW_ANONYMOUS_PUBLISH="true"
