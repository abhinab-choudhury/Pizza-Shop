PORT="3010"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3009"
WEB_CLIENT="https://pizza-shop-client.vercel.app"
ADMIN_CLIENT="https://pizza-shop-admin-client.vercel.app"
DELIVERY_AGENT_WEB="http://localhost:3009"
