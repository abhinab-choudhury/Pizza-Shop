CREATE TABLE IF NOT EXISTS CartItem (
    pizzaId TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    description TEXT NOT NULL,
    price REAL NOT NULL,
    imageUrl TEXT,
    category TEXT NOT NULL DEFAULT 'classic',
    quantity INTEGER NOT NULL DEFAULT 1
);

getAllCartItems:
SELECT * FROM CartItem;

getCartItemByPizzaId:
SELECT * FROM CartItem WHERE pizzaId = ?;

getCartItemCount:
SELECT COALESCE(SUM(quantity), 0) FROM CartItem;

getCartTotal:
SELECT COALESCE(SUM(price * quantity), 0.0) FROM CartItem;

insertCartItem:
INSERT OR REPLACE INTO CartItem(pizzaId, name, description, price, imageUrl, category, quantity)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateQuantity:
UPDATE CartItem SET quantity = ? WHERE pizzaId = ?;

deleteCartItem:
DELETE FROM CartItem WHERE pizzaId = ?;

clearCart:
DELETE FROM CartItem;
